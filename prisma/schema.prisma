// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  STUDENT
  TEACHER
  WORKER
  GUARDIAN
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  Roles
  users User[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id])
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  teacher Teacher[]
}

model Academic_years{
  id          String @id @default(uuid()) @db.Uuid
  name        String
  starting_date  DateTime
  ending_date    DateTime
  curr_year  Boolean    @default(false)
  sections Section[]
}

model Class{
  id String @id @default(uuid()) @db.Uuid
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime
  sections Section[]
  subjects ClassSubject[]
}

model Section{
  id String @id @default(uuid()) @db.Uuid
  name String
  capacity Int
  class_id String @db.Uuid
  class Class @relation(fields:[class_id],references: [id])
  academic_year_id String @db.Uuid
  academic_years Academic_years @relation(fields:[academic_year_id],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([name, class_id, academic_year_id])
}

model Subject{
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  classes ClassSubject[]
}

model ClassSubject {
  id         String   @id @default(uuid()) @db.Uuid
  class_id   String   @db.Uuid
  class      Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject_id String   @db.Uuid
  subject    Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([class_id, subject_id])
  @@index([class_id])
  @@index([subject_id])
}

enum Status{
  ACTIVE
  INVITED
  INACTIVE
}
model Teacher{
  id String @id @default(uuid()) @db.Uuid
  name String
  employee_num Int
  user_id String @db.Uuid
  user User @relation(fields:[user_id],references:[id])
  email String @unique
  phone Int
  joinind_date DateTime
  Status  Status @default(INVITED)
  created_at DateTime @default(now())
  updated_at DateTime

}

model UserInvitation {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  role         Roles
  employee_num Int?
  phone        Int?
  joinind_date DateTime?
  token_hash   String   @unique
  expires_at   DateTime
  accepted_at  DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}
